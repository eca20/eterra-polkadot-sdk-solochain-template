#!/bin/bash
set -euo pipefail
# Closed union of every credential-bearing environment variable accepted by the
# chain, site, or Unity private-alpha deployment lanes.  Preserve each shell
# value for local use, but remove its export attribute before the first child.
export -n DEPLOY_PASSWORD REMOTE_SUDO_PASSWORD AURA_SURI GRAN_SURI \
	MEDIA_SIGNER_SEED MEDIA_ADMIN_API_KEY AUTHORITY_RELAY_MNEMONIC \
	AUTHORITY_RELAY_DERIVATION_PASSWORD ETERRA_LEGENDS_SIGNER_MNEMONIC \
	ETERRA_LEGENDS_SIGNER_DERIVATION_PASSWORD ETERRA_LEGENDS_PRIVATE_ALPHA_ACCESS_KEY \
	ETERRA_ALPHA_SUDO_MNEMONIC ETERRA_ALPHA_SUDO_DERIVATION_PASSWORD \
	ADMIN_SESSION_SECRET ALPHA_ACCESS_SESSION_SECRET DISCORD_CLIENT_SECRET \
	DISCORD_BOT_TOKEN MONGODB_URI ETERRA_LEGENDS_PLAYER_ACCESS_TOKEN \
	NEXUS_V2_PRIVATE_ALPHA_ACCESS_KEY NEXUS_V2_SESSION_AUTHORIZATION_PROFILES_JSON \
	ADMIN_API_KEY ETERRA_FPS_V2_OWNER_SECRET_PATH \
	ETERRA_FPS_V2_PLAYER_GATEWAY_ACCESS_TOKEN ETERRA_FPS_V2_ROOT_SECRET_PATH \
	ETERRA_FPS_V2_SUDO_SECRET_PATH 2>/dev/null || true
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "${SCRIPT_DIR}/lib.sh"

action=""
transaction_id=""
release_id=""
source_commit=""
component_source_commit=""
role=""
target=""
bundle_root=""
result_path=""
runtime_bundle=""
runtime_bundle_manifest_sha256=""
runtime_v14_metadata=""
isolated_rpc_port=19948
isolated_p2p_port=31348
frozen_block_number=""
frozen_block_hash=""
dry_run=0
artifacts=()

while [[ $# -gt 0 ]]; do
	case "$1" in
		--action) action="${2:?missing action}"; shift ;;
		--transaction-id) transaction_id="${2:?missing transaction ID}"; shift ;;
		--release-id) release_id="${2:?missing release ID}"; shift ;;
		--source-commit) source_commit="${2:?missing source commit}"; shift ;;
		--component-source-commit) component_source_commit="${2:?missing component source commit}"; shift ;;
		--role) role="${2:?missing role}"; shift ;;
		--target) target="${2:?missing target}"; shift ;;
		--bundle-root) bundle_root="${2:?missing bundle root}"; shift ;;
		--result) result_path="${2:?missing result path}"; shift ;;
		--runtime-bundle) runtime_bundle="${2:?missing runtime bundle}"; shift ;;
		--runtime-bundle-manifest-sha256) runtime_bundle_manifest_sha256="${2:?missing runtime bundle manifest SHA-256}"; shift ;;
		--runtime-v14-metadata) runtime_v14_metadata="${2:?missing runtime V14 metadata}"; shift ;;
		--isolated-rpc-port) isolated_rpc_port="${2:?missing isolated RPC port}"; shift ;;
		--isolated-p2p-port) isolated_p2p_port="${2:?missing isolated P2P port}"; shift ;;
		--frozen-block-number) frozen_block_number="${2:?missing frozen block number}"; shift ;;
		--frozen-block-hash) frozen_block_hash="${2:?missing frozen block hash}"; shift ;;
		--artifact) artifacts+=("${2:?missing artifact role}"); shift ;;
		--dry-run) dry_run=1 ;;
		--help|-h)
			cat <<'EOF'
Implements the final_freeze.py component protocol for chain-host roles:
authority, chain, and media-ipfs. The chain role additionally requires:
  --runtime-bundle DIR --runtime-bundle-manifest-sha256 SHA256
  --runtime-v14-metadata FILE
  [--isolated-rpc-port PORT --isolated-p2p-port PORT]

The chain role creates its try-runtime snapshot after the stop from an isolated
extraction of the exact captured node-data archive; pre-existing snapshots are
not accepted. The driver never restarts a service. A freeze or snapshot failure
leaves every already-stopped component stopped. Dry-run validates local configuration and
the complete action contract without SSH or live mutation.
EOF
			exit 0
			;;
		*) die "unknown final-freeze driver argument: $1" ;;
	esac
	shift
done

[[ "${action}" =~ ^(preflight|freeze|verify-frozen|snapshot|verify-snapshot)$ ]] || die "invalid final-freeze action"
[[ "${transaction_id}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die "invalid final-freeze transaction ID"
[[ "${release_id}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die "invalid final-freeze release ID"
[[ "${source_commit}" =~ ^[0-9a-f]{40}$ ]] || die "invalid final-freeze source commit"
[[ "${component_source_commit}" =~ ^[0-9a-f]{40}$ ]] || die "invalid final-freeze component source commit"
[[ "${role}" =~ ^(authority|chain|media-ipfs)$ ]] || die "chain-host driver cannot service role: ${role}"
[[ "${target}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die "invalid final-freeze target"
[[ -n "${bundle_root}" && -d "${bundle_root}" && ! -L "${bundle_root}" ]] || die "final-freeze bundle root must be an existing regular directory"
[[ -n "${result_path}" && ! -e "${result_path}" ]] || die "refusing to overwrite final-freeze result"

load_env
require_cmd jq
require_cmd python3
require_cmd rsync
require_cmd shasum
require_cmd ssh
require_cmd tar
require_cmd curl

if [[ "${ETERRA_RELEASE_VERSION}" != "${release_id}" ]]; then
	die "final-freeze release does not match protected Alpha environment"
fi
if [[ "${ETERRA_EXPECTED_CHAIN_COMMIT}" != "${source_commit}" ]]; then
	die "final-freeze source does not match protected Alpha environment"
fi
require_release_source "${REPO_ROOT}" "final-freeze chain-host driver" "${source_commit}" >/dev/null

case "${role}" in
	authority) expected_component_source_commit="${ETERRA_EXPECTED_SDKGEN_COMMIT}" ;;
	chain) expected_component_source_commit="${ETERRA_EXPECTED_CHAIN_COMMIT}" ;;
	media-ipfs) expected_component_source_commit="${ETERRA_EXPECTED_MEDIA_COMMIT}" ;;
esac
[[ -n "${expected_component_source_commit}" ]] || die "protected Alpha component source commit is not configured for ${role}"
[[ "${component_source_commit}" == "${expected_component_source_commit}" ]] ||
	die "final-freeze component source does not match protected Alpha environment for ${role}"

expected_roles=""
case "${role}" in
	authority)
		expected_roles=$'authority:authority-state\nconfig:authority-env\nservice:authority-service'
		;;
	chain)
		expected_roles=$'config:chain-spec\nconfig:node-env\nnode:legacy-source-inventory\nnode:node-binary\nnode:node-data\nnode:runtime-v14-metadata\nnode:runtime-v14-wasm\nnode:runtime-v16-production-wasm\nnode:runtime-v16-try-runtime-wasm\nnode:tcg-storage-version-observation\nnode:try-runtime-snapshot\nnode:try-runtime-snapshot-proof\nservice:node-service'
		[[ -d "${runtime_bundle}" && ! -L "${runtime_bundle}" ]] || die "chain snapshot requires a regular runtime bundle directory"
		[[ "${runtime_bundle_manifest_sha256}" =~ ^[0-9a-f]{64}$ ]] || die "chain snapshot requires a runtime bundle manifest SHA-256"
		[[ -f "${runtime_v14_metadata}" && ! -L "${runtime_v14_metadata}" ]] || die "chain snapshot requires regular runtime V14 metadata"
		[[ "${isolated_rpc_port}" =~ ^[0-9]+$ && "${isolated_p2p_port}" =~ ^[0-9]+$ ]] || die "isolated snapshot ports must be numeric"
		(( isolated_rpc_port >= 1024 && isolated_rpc_port <= 65535 && isolated_p2p_port >= 1024 && isolated_p2p_port <= 65535 )) || die "isolated snapshot ports must be in 1024..65535"
		[[ "${isolated_rpc_port}" != "${isolated_p2p_port}" && "${isolated_rpc_port}" != "${CHAIN_RPC_PORT}" && "${isolated_p2p_port}" != "${CHAIN_P2P_PORT}" ]] || die "isolated snapshot ports must be distinct from each other and live Alpha"
		freeze_runtime_verifier="${REPO_ROOT}/scripts/nexus-v2-private-alpha/final_freeze_runtime_bundle.py"
		freeze_runtime_verifier_sha256="9ada268fe0ffa13e156f16b9a39ce8861e6a007f070b8f283850ec229157126f"
		[[ -f "${freeze_runtime_verifier}" && ! -L "${freeze_runtime_verifier}" ]] || die "final-freeze runtime bundle verifier is unavailable"
		[[ "$(shasum -a 256 "${freeze_runtime_verifier}" | awk '{print $1}')" == "${freeze_runtime_verifier_sha256}" ]] || die "final-freeze runtime bundle verifier hash mismatch"
		python3 "${freeze_runtime_verifier}" \
			--runtime-bundle "${runtime_bundle}" \
			--expected-manifest-sha256 "${runtime_bundle_manifest_sha256}" >/dev/null ||
			die "runtime bundle is not the exact frozen Linux spec-106 private-alpha candidate"
		deployed_source_commit="$(jq -er '.liveSource.commit | select(test("^[0-9a-f]{40}$"))' "${runtime_bundle}/tcg-storage-version-observation.json")" ||
			die "runtime bundle TCG observation deployed source commit is invalid"
		try_runtime_bin="${runtime_bundle}/try-runtime"
		[[ -x "${try_runtime_bin}" && -f "${try_runtime_bin}" && ! -L "${try_runtime_bin}" ]] || die "runtime bundle try-runtime CLI is unavailable"
		try_runtime_sha256="$(jq -er '.artifacts.tryRuntimeCliSha256 | select(test("^[0-9a-f]{64}$"))' "${runtime_bundle}/runtime-bundle-manifest.json")" || die "runtime bundle try-runtime hash is invalid"
		[[ "$(shasum -a 256 "${try_runtime_bin}" | awk '{print $1}')" == "${try_runtime_sha256}" ]] || die "runtime bundle try-runtime CLI hash mismatch"
		try_runtime_revision="$(jq -er '.tools.tryRuntimeRevision | select(test("^[0-9a-f]{40}$"))' "${runtime_bundle}/runtime-bundle-manifest.json")" || die "runtime bundle try-runtime revision is invalid"
		try_runtime_version="$("${try_runtime_bin}" --version)" || die "runtime bundle try-runtime CLI cannot execute on the coordinator host"
		[[ -n "${try_runtime_version}" ]] || die "runtime bundle try-runtime CLI returned an empty version"
		;;
	media-ipfs)
		expected_roles=$'config:media-env\nipfs:ipfs-data\nipfs:ipfs-staging\nmedia:media-image-lock\nmedia:media-state\nservice:media-service'
		;;
esac

actual_roles="$(printf '%s\n' "${artifacts[@]}" | LC_ALL=C sort)"
[[ "${actual_roles}" == "$(LC_ALL=C sort <<<"${expected_roles}")" ]] || die "${role} artifact roles do not match the closed set"

remote_transaction_root="${DEPLOY_ROOT}/archive/nexus-v2-final-freeze/${transaction_id}"
remote_marker="${remote_transaction_root}/freeze-${role}.json"
local_capture_root="${bundle_root}/artifacts"
mkdir -p "${local_capture_root}" "$(dirname -- "${result_path}")"

checks_for_action() {
	case "$1:$2" in
		*:preflight) printf '%s\n' credentialsAvailable driverPinned restoreInputsIdentified snapshotDestinationWritable targetResolved ;;
		authority:freeze) printf '%s\n' authorityStopped resultSubmissionStopped ;;
		chain:freeze) printf '%s\n' blockProductionStopped finalizedHeadCaptured nodeP2pStopped nodeRpcStopped nodeStopped ;;
		media-ipfs:freeze) printf '%s\n' ipfsStopped mediaStopped uploadIngressStopped ;;
		authority:verify-frozen) printf '%s\n' authorityStopped remainsStopped resultSubmissionStopped ;;
		chain:verify-frozen) printf '%s\n' blockProductionStopped finalizedHeadCaptured nodeP2pStopped nodeRpcStopped nodeStopped remainsStopped ;;
		media-ipfs:verify-frozen) printf '%s\n' ipfsStopped mediaStopped remainsStopped uploadIngressStopped ;;
		*:snapshot) printf '%s\n' artifactHashesComputed artifactRolesComplete consistentSnapshotCaptured privateBundlePermissionsRestricted ;;
		*:verify-snapshot) printf '%s\n' archivesReadable artifactHashesVerified noServiceResumed restoreContractReady ;;
		*) die "unsupported check set: $1:$2" ;;
	esac
}

artifact_specs=()
record_artifact() {
	local group="$1"
	local name="$2"
	local relative="$3"
	local path="${bundle_root}/${relative}"
	[[ -f "${path}" && ! -L "${path}" ]] || die "snapshot artifact unavailable: ${group}:${name}"
	artifact_specs+=("${group}:${name}:${relative}")
}

write_result() {
	local frozen_at="$1"
	local block_number="$2"
	local block_hash="$3"
	local check_names
	check_names="$(checks_for_action "${role}" "${action}" | paste -sd, -)"
	python3 - \
		"${result_path}" "${action}" "${transaction_id}" "${release_id}" "${source_commit}" \
		"${role}" "${target}" "${dry_run}" "${frozen_at}" "${block_number}" "${block_hash}" \
		"${check_names}" "${bundle_root}" "${artifact_specs[@]}" <<'PY'
import hashlib
import json
import os
import pathlib
import sys

(
    output,
    action,
    transaction_id,
    release_id,
    source_commit,
    role,
    target,
    dry_run_raw,
    frozen_at,
    block_number,
    block_hash,
    checks_raw,
    bundle_root,
    *artifact_specs,
) = sys.argv[1:]
dry_run = dry_run_raw == "1"
artifacts = []
for spec in artifact_specs:
    group, name, relative = spec.split(":", 2)
    path = pathlib.Path(bundle_root) / relative
    payload = path.read_bytes()
    artifacts.append(
        {
            "group": group,
            "name": name,
            "path": relative,
            "bytes": len(payload),
            "sha256": hashlib.sha256(payload).hexdigest(),
        }
    )
frozen_block = None
if block_number and block_hash:
    frozen_block = {"number": int(block_number), "hash": block_hash}
value = {
    "schemaVersion": 1,
    "kind": "nexus-v2-private-alpha-final-freeze-component-result",
    "transactionId": transaction_id,
    "releaseId": release_id,
    "sourceCommit": source_commit,
    "role": role,
    "action": action,
    "target": target,
    "dryRun": dry_run,
    "liveMutationPerformed": False if dry_run or action not in ("freeze", "snapshot") else True,
    "planned": dry_run,
    "frozenAtUtc": frozen_at or None,
    "frozenFinalizedBlock": frozen_block,
    "checks": {name: True for name in checks_raw.split(",") if name},
    "artifacts": artifacts,
}
payload = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()
descriptor = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(descriptor, "wb") as handle:
    handle.write(payload)
PY
}

if [[ "${dry_run}" -eq 1 ]]; then
	write_result "" "" ""
	exit 0
fi

remote_marker_json=""
read_remote_marker() {
	remote_marker_json="$(remote_root_bash <<EOF
set -euo pipefail
cat "${remote_marker}"
EOF
)" ||
		die "${role} freeze marker is unavailable"
	[[ "$(jq -r '.schemaVersion' <<<"${remote_marker_json}")" == "1" ]] || die "${role} freeze marker schema mismatch"
	[[ "$(jq -r '.transactionId' <<<"${remote_marker_json}")" == "${transaction_id}" ]] || die "${role} freeze marker transaction mismatch"
	[[ "$(jq -r '.releaseId' <<<"${remote_marker_json}")" == "${release_id}" ]] || die "${role} freeze marker release mismatch"
	[[ "$(jq -r '.sourceCommit' <<<"${remote_marker_json}")" == "${source_commit}" ]] || die "${role} freeze marker source mismatch"
	[[ "$(jq -r '.componentSourceCommit' <<<"${remote_marker_json}")" == "${component_source_commit}" ]] || die "${role} freeze marker component source mismatch"
	[[ "$(jq -r '.role' <<<"${remote_marker_json}")" == "${role}" ]] || die "${role} freeze marker role mismatch"
}

verify_stopped() {
	case "${role}" in
		authority)
			remote_root_bash <<EOF
set -euo pipefail
! systemctl is-active --quiet "${AUTHORITY_SERVICE_NAME}.service"
! ss -ltnH 'sport = :${AUTHORITY_PORT}' | grep -q .
EOF
			;;
	chain)
			remote_root_bash <<EOF
set -euo pipefail
! systemctl is-active --quiet "${REMOTE_NODE_SERVICE_NAME}.service"
! ss -ltnH 'sport = :${CHAIN_RPC_PORT}' | grep -q .
! ss -ltnH 'sport = :${CHAIN_P2P_PORT}' | grep -q .
EOF
			;;
	media-ipfs)
			remote_root_bash <<EOF
set -euo pipefail
test -z "\$(${REMOTE_DOCKER_COMPOSE_CMD} ps -q --status running media-service)"
test -z "\$(${REMOTE_DOCKER_COMPOSE_CMD} ps -q --status running ipfs)"
! ss -ltnH 'sport = :${MEDIA_PORT}' | grep -q .
! ss -ltnH 'sport = :${IPFS_API_PORT}' | grep -q .
! ss -ltnH 'sport = :${IPFS_GATEWAY_PORT}' | grep -q .
EOF
			;;
	esac
}

if [[ "${action}" == "preflight" ]]; then
	case "${role}" in
		authority)
			remote_root_bash <<EOF
set -euo pipefail
systemctl cat "${AUTHORITY_SERVICE_NAME}.service" >/dev/null
test -d "${REMOTE_AUTHORITY_DIR}"
test -r "${REMOTE_AUTHORITY_ENV_FILE}"
test -r "${REMOTE_AUTHORITY_SERVICE_UNIT_FILE}"
test -d "${DEPLOY_ROOT}"
EOF
			;;
	chain)
			remote_root_bash <<EOF
set -euo pipefail
systemctl cat "${REMOTE_NODE_SERVICE_NAME}.service" >/dev/null
test -d "${REMOTE_NODE_DATA_DIR}"
test -x "${REMOTE_NODE_BIN}"
test -r "${REMOTE_NODE_SPEC}"
test -r "${REMOTE_NODE_ENV_FILE}"
test -d "${DEPLOY_ROOT}"
test "\$(uname -s)" = "Linux"
test "\$(uname -m)" = "x86_64"
test "\$(uname -r)" != ""
uname -srm >/dev/null
. /etc/os-release
test "\${ID}" = "ubuntu"
test "\${VERSION_ID}" = "24.04"
! ss -ltnH 'sport = :${isolated_rpc_port}' | grep -q .
! ss -ltnH 'sport = :${isolated_p2p_port}' | grep -q .
python3 - "${REMOTE_NODE_BIN}" <<'PY'
import pathlib
import struct
import sys
with pathlib.Path(sys.argv[1]).open("rb") as handle:
    header = handle.read(64)
assert len(header) >= 64 and header[:7] == b"\x7fELF\x02\x01\x01"
assert struct.unpack_from("<H", header, 18)[0] == 62
PY
"${REMOTE_NODE_BIN}" --version >/dev/null
EOF
			;;
	media-ipfs)
			remote_root_bash <<EOF
set -euo pipefail
${REMOTE_DOCKER_COMPOSE_CMD} config >/dev/null
docker volume inspect "${REMOTE_IPFS_DATA_VOLUME}" >/dev/null
docker volume inspect "${REMOTE_IPFS_STAGING_VOLUME}" >/dev/null
test -r "${REMOTE_MEDIA_ENV_FILE}"
test -d "${DEPLOY_ROOT}"
EOF
			;;
	esac
	write_result "" "" ""
	exit 0
fi

if [[ "${action}" == "freeze" ]]; then
	case "${role}" in
		authority)
			remote_root_bash <<EOF
set -euo pipefail
mkdir -p "${remote_transaction_root}"
if [[ ! -e "${remote_marker}" ]]; then
	systemctl stop "${AUTHORITY_SERVICE_NAME}.service"
	! systemctl is-active --quiet "${AUTHORITY_SERVICE_NAME}.service"
	! ss -ltnH 'sport = :${AUTHORITY_PORT}' | grep -q .
	frozen_at="\$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	jq -n --arg transactionId "${transaction_id}" --arg releaseId "${release_id}" \
		--arg sourceCommit "${source_commit}" --arg componentSourceCommit "${component_source_commit}" --arg role "${role}" --arg frozenAtUtc "\${frozen_at}" \
		'{schemaVersion:1,transactionId:\$transactionId,releaseId:\$releaseId,sourceCommit:\$sourceCommit,componentSourceCommit:\$componentSourceCommit,role:\$role,frozenAtUtc:\$frozenAtUtc,frozenFinalizedBlock:null}' \
		>"${remote_marker}"
	chmod 0440 "${remote_marker}"
fi
EOF
			;;
	chain)
			remote_root_bash <<EOF
set -euo pipefail
mkdir -p "${remote_transaction_root}"
if [[ ! -e "${remote_marker}" ]]; then
	finalized_response="\$(curl -fsS --max-time 10 -H 'Content-Type: application/json' \
		-d '{"id":1,"jsonrpc":"2.0","method":"chain_getFinalizedHead","params":[]}' \
		'http://127.0.0.1:${CHAIN_RPC_PORT}')"
	finalized_hash="\$(jq -er '.result | select(test("^0x[0-9a-fA-F]{64}$"))' <<<"\${finalized_response}")"
	header_response="\$(curl -fsS --max-time 10 -H 'Content-Type: application/json' \
		-d "{\"id\":1,\"jsonrpc\":\"2.0\",\"method\":\"chain_getHeader\",\"params\":[\"\${finalized_hash}\"]}" \
		'http://127.0.0.1:${CHAIN_RPC_PORT}')"
	number_hex="\$(jq -er '.result.number | select(test("^0x[0-9a-fA-F]+$"))' <<<"\${header_response}")"
	number_dec="\$(python3 -c 'import sys; print(int(sys.argv[1], 16))' "\${number_hex}")"
	systemctl stop "${REMOTE_NODE_SERVICE_NAME}.service"
	! systemctl is-active --quiet "${REMOTE_NODE_SERVICE_NAME}.service"
	! ss -ltnH 'sport = :${CHAIN_RPC_PORT}' | grep -q .
	! ss -ltnH 'sport = :${CHAIN_P2P_PORT}' | grep -q .
	frozen_at="\$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	jq -n --arg transactionId "${transaction_id}" --arg releaseId "${release_id}" \
		--arg sourceCommit "${source_commit}" --arg componentSourceCommit "${component_source_commit}" --arg role "${role}" --arg frozenAtUtc "\${frozen_at}" \
		--arg hash "\${finalized_hash}" --argjson number "\${number_dec}" \
		'{schemaVersion:1,transactionId:\$transactionId,releaseId:\$releaseId,sourceCommit:\$sourceCommit,componentSourceCommit:\$componentSourceCommit,role:\$role,frozenAtUtc:\$frozenAtUtc,frozenFinalizedBlock:{number:\$number,hash:\$hash}}' \
		>"${remote_marker}"
	chmod 0440 "${remote_marker}"
fi
EOF
			;;
	media-ipfs)
			remote_root_bash <<EOF
set -euo pipefail
mkdir -p "${remote_transaction_root}"
if [[ ! -e "${remote_marker}" ]]; then
	${REMOTE_DOCKER_COMPOSE_CMD} stop media-service ipfs
	test -z "\$(${REMOTE_DOCKER_COMPOSE_CMD} ps -q --status running media-service)"
	test -z "\$(${REMOTE_DOCKER_COMPOSE_CMD} ps -q --status running ipfs)"
	frozen_at="\$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	jq -n --arg transactionId "${transaction_id}" --arg releaseId "${release_id}" \
		--arg sourceCommit "${source_commit}" --arg componentSourceCommit "${component_source_commit}" --arg role "${role}" --arg frozenAtUtc "\${frozen_at}" \
		'{schemaVersion:1,transactionId:\$transactionId,releaseId:\$releaseId,sourceCommit:\$sourceCommit,componentSourceCommit:\$componentSourceCommit,role:\$role,frozenAtUtc:\$frozenAtUtc,frozenFinalizedBlock:null}' \
		>"${remote_marker}"
	chmod 0440 "${remote_marker}"
fi
EOF
			;;
	esac
	verify_stopped
	read_remote_marker
	frozen_at="$(jq -er '.frozenAtUtc' <<<"${remote_marker_json}")"
	if [[ "${role}" == "chain" ]]; then
		marker_block_number="$(jq -er '.frozenFinalizedBlock.number' <<<"${remote_marker_json}")"
		marker_block_hash="$(jq -er '.frozenFinalizedBlock.hash' <<<"${remote_marker_json}")"
		write_result "${frozen_at}" "${marker_block_number}" "${marker_block_hash}"
	else
		write_result "${frozen_at}" "" ""
	fi
	exit 0
fi

[[ "${frozen_block_number}" =~ ^[0-9]+$ ]] || die "${action} requires the coordinator's frozen block number"
[[ "${frozen_block_hash}" =~ ^0x[0-9a-fA-F]{64}$ ]] || die "${action} requires the coordinator's frozen block hash"
verify_stopped
read_remote_marker
frozen_at="$(jq -er '.frozenAtUtc' <<<"${remote_marker_json}")"
if [[ "${role}" == "chain" ]]; then
	[[ "$(jq -r '.frozenFinalizedBlock.number' <<<"${remote_marker_json}")" == "${frozen_block_number}" ]] || die "chain freeze marker block number mismatch"
	[[ "$(jq -r '.frozenFinalizedBlock.hash' <<<"${remote_marker_json}")" == "${frozen_block_hash}" ]] || die "chain freeze marker block hash mismatch"
fi

if [[ "${action}" == "verify-frozen" ]]; then
	write_result "${frozen_at}" "${frozen_block_number}" "${frozen_block_hash}"
	exit 0
fi

if [[ "${action}" == "snapshot" ]]; then
	remote_capture="${remote_transaction_root}/capture-${role}"
	case "${role}" in
		authority)
			remote_root_bash <<EOF
set -euo pipefail
test ! -e "${remote_capture}"
