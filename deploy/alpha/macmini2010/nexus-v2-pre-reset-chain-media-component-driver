        "stagingPath": str(staging) if staging is not None else None,
    }


def validate_protected_result(
    value: Mapping[str, Any],
    context: Mapping[str, Any],
    action: str,
    mode: str,
) -> dict[str, Any]:
    require(set(value) == PROTECTED_RESULT_KEYS, f"protected {action} result schema mismatch")
    require(
        value.get("schemaVersion") == 1
        and value.get("kind") == "nexus-v2-private-alpha-component-action-result"
        and value.get("operationId") == context["operationId"]
        and value.get("planSha256") == context["sha256"]
        and value.get("releaseId") == context["releaseId"]
        and value.get("sourceCommit") == context["sourceCommit"]
        and value.get("componentSourceCommits")
        == {"chain": context["commits"]["chain"], "media": context["commits"]["media"]}
        and value.get("componentId") == COMPONENT_ID
        and value.get("action") == action
        and value.get("mode") == mode
        and value.get("result") == "passed",
        f"protected {action} result identity mismatch",
    )
    remote_actions = value.get("remoteActionsExecuted")
    already_applied = value.get("alreadyApplied")
    require(
        isinstance(remote_actions, bool) and isinstance(already_applied, bool),
        f"protected {action} mutation flags are invalid",
    )
    marker_hash = value.get("remoteIdempotencyMarkerSha256")
    if mode == "dry-run":
        require(
            remote_actions is False
            and already_applied is False
            and marker_hash is None,
            f"protected {action} preflight mutated or reused state",
        )
    elif already_applied:
        require(remote_actions is False, f"protected {action} repeated an idempotent action")
        ensure_sha256(marker_hash, f"protected {action} idempotency marker SHA-256")
    else:
        require(remote_actions is True, f"protected {action} reports no remote action")
        ensure_sha256(marker_hash, f"protected {action} idempotency marker SHA-256")
    archives = value.get("requiredResetArchives")
    require(
        isinstance(archives, dict)
        and set(archives) == ARCHIVE_ROLES
        and all(item is True for item in archives.values()),
        f"protected {action} reset archives are incomplete",
    )
    failed_hash = value.get("failedV2RootArchiveSha256")
    if mode == "execute" and action != "pause-v2-writes":
        ensure_sha256(failed_hash, f"protected {action} failed-root SHA-256")
    else:
        require(failed_hash is None, f"protected {action} reports an unexpected failed root")
    checks = value.get("checks")
    if mode == "prepare":
        expected_checks = PROTECTED_PREPARE_CHECKS
    elif mode == "dry-run":
        expected_checks = PROTECTED_DRY_CHECKS[action]
    else:
        expected_checks = PROTECTED_EXEC_CHECKS[action]
    require(
        isinstance(checks, dict)
        and set(checks) == expected_checks
        and all(item is True for item in checks.values()),
        f"protected {action} checks did not all pass",
    )
    completed = value.get("completedAtUtc")
    require(
        isinstance(completed, str)
        and re.fullmatch(
            r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z",
            completed,
        )
        is not None,
        f"protected {action} completion time is invalid",
    )
    return dict(value)


def stage_backup(context: Mapping[str, Any], destination: Path) -> None:
    expected_hashes = validated_staging_hashes(context)
    library = load_staging_library(context["scripts"]["rollbackStagingLibrary"])
    require(
        getattr(library, "STAGING_NAMES", None) == STAGING_NAMES,
        "pinned rollback staging layout drifted",
    )
    stage_context = {
        "plan": context["raw"],
        "planSha256": context["sha256"],
        "manifestPath": context["artifacts"]["backupManifest"]["path"],
        "bundleRoot": context["bundleRoot"],
        "manifestSha256": context["artifacts"]["backupManifest"]["sha256"],
        "componentCommits": {
            "chain": context["commits"]["chain"],
            "media": context["commits"]["media"],
        },
    }
    library.stage_final_backup(stage_context, destination)
    for name, expected in expected_hashes.items():
        staged = destination / name
        require(
            staged.is_file()
            and not staged.is_symlink()
            and sha256_file(staged) == expected,
            f"restore staging bytes drifted: {name}",
        )
    staging_contract = read_json(
        destination / "staging-contract.json", "restore staging contract"
    )
    require(
        set(staging_contract) == STAGING_CONTRACT_KEYS
        and staging_contract.get("schemaVersion") == 1
        and staging_contract.get("kind")
        == "nexus-v2-private-alpha-chain-media-restore-staging"
        and staging_contract.get("releaseId") == context["releaseId"]
        and staging_contract.get("sourceCommit") == context["sourceCommit"]
        and staging_contract.get("componentSourceCommits")
        == {"chain": context["commits"]["chain"], "media": context["commits"]["media"]}
        and staging_contract.get("planSha256") == context["sha256"]
        and staging_contract.get("backupManifestSha256")
        == context["artifacts"]["backupManifest"]["sha256"]
        and staging_contract.get("files") == expected_hashes,
        "restore staging contract identity mismatch",
    )
    require(
        isinstance(staging_contract.get("createdAtUtc"), str)
        and re.fullmatch(
            r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z",
            staging_contract["createdAtUtc"],
        )
        is not None,
        "restore staging completion time is invalid",
    )


def invoke_protected(
    context: Mapping[str, Any], action: str, mode: str, root: Path
) -> dict[str, Any]:
    attempt = root / f"{mode}.{action}"
    attempt.mkdir(mode=0o700)
    staging: Path | None = None
    if action == "restore-final-backup":
        staging = attempt / "restore-staging"
        stage_backup(context, staging)
    input_path = attempt / "context.json"
    result_path = attempt / "result.json"
    write_new(input_path, protected_context(context, action, mode, staging), 0o400)
    environment = os.environ.copy()
    environment["NEXUS_V2_ROLLBACK_PROTECTED_CONFIRMATION"] = CONFIRMATION
    completed = subprocess.run(
        [
            str(context["helpers"]["hostAction"]),
            "--context",
            str(input_path),
            "--result",
            str(result_path),
        ],
        env=environment,
        check=False,
    )
    require(completed.returncode == 0, f"protected {action} helper failed")
    value = read_json(result_path, f"protected {action} result")
    return validate_protected_result(value, context, action, mode)


def fixture_action(context: Mapping[str, Any], args: argparse.Namespace) -> str | None:
    root = Path(str(context["fixtureRoot"])).resolve()
    require(root.name.endswith(".NONDEPLOYABLE"), "fixture root is deployable")
    contract = read_json(root / "fixture-contract.json", "NONDEPLOYABLE fixture contract")
    require(contract.get("fixtureOnly") is True, "fixture flag is absent")
    if args.mode == "preflight":
        return None
    marker_root = root / "pre-reset-markers" / context["operationId"] / COMPONENT_ID
    marker_root.mkdir(parents=True, exist_ok=True)
    marker = marker_root / f"{args.action}.json"
    archive_hash = None
    if args.mode == "execute" and args.action != "pause-v2-writes":
        archive_hash = hashlib.sha256(
            f"{context['sha256']}:{COMPONENT_ID}:failed-v2".encode()
        ).hexdigest()
    if not marker.exists():
        write_new(
            marker,
            {"action": args.action, "failedV2RootArchiveSha256": archive_hash},
            0o400,
        )
    return archive_hash


def result_value(
    context: Mapping[str, Any], args: argparse.Namespace, failed_hash: str | None
) -> dict[str, Any]:
    if args.mode == "prepare":
        checks = PREPARATION_CHECKS
    elif args.mode == "preflight":
        checks = PREFLIGHT_CHECKS
    else:
        checks = ACTION_CHECKS[args.action]
    return {
        "schemaVersion": 1,
        "kind": "nexus-v2-private-alpha-pre-reset-recovery-result",
        "operationId": context["operationId"],
        "releaseId": context["releaseId"],
        "siteReleaseVersion": context["siteReleaseVersion"],
        "planSha256": context["sha256"],
        "componentId": COMPONENT_ID,
        "mode": args.mode,
        "action": args.action,
        "result": "passed",
        "fixtureOnly": context["fixtureOnly"],
        "mutationPerformed": args.mode in {"prepare", "execute"},
        "credentialsResolvable": True,
        "requiredResetArchivesPresent": True,
        "failedV2RootArchiveSha256": failed_hash,
        "checks": {name: True for name in checks},
        "completedAtUtc": dt.datetime.now(dt.timezone.utc)
        .replace(microsecond=0)
        .strftime("%Y-%m-%dT%H:%M:%SZ"),
    }


def run(args: argparse.Namespace) -> None:
    result_path = Path(args.result).resolve()
    # Refuse a colliding evidence target before any protected helper can run.
    # Discovering the collision after a host mutation would make the action
    # unauditable even though the remote recovery itself succeeded.
    require(not os.path.lexists(result_path), "refusing to overwrite recovery result")
    require(args.component == COMPONENT_ID, "driver supports only chain-media")
    require(args.mode in {"prepare", "preflight", "execute"}, "unsupported driver mode")
    require(args.action in ACTIONS, "unsupported driver action")
    require(
        (args.mode == "prepare" and args.action == "prepare-reset-archives")
        or (args.mode == "preflight" and args.action == "preflight")
        or (args.mode == "execute" and args.action in ACTION_CHECKS),
        "driver mode/action mismatch",
    )
    context = validate_plan(args)
    failed_hash: str | None = None
    if context["fixtureOnly"]:
        failed_hash = fixture_action(context, args)
    else:
        require(context["backend"] == PRODUCTION_BACKEND, "unsupported protected backend")
        require(
            os.environ.get("NEXUS_V2_PRE_RESET_PRODUCTION_CONFIRMATION")
            == CONFIRMATION,
            "protected chain-media action lacks PRIVATE_ALPHA_ROLLBACK_ONLY confirmation",
        )
        with tempfile.TemporaryDirectory(prefix="nexus-v2-pre-reset-chain-media-") as temp:
            action_root = Path(temp)
            os.chmod(action_root, 0o700)
            if args.mode == "prepare":
                # A prepared host archive is useful only when the exact final
                # backup bytes it will restore are still complete and pinned.
                validated_staging_hashes(context)
                invoke_protected(
                    context, "prepare-reset-archives", "prepare", action_root
                )
            elif args.mode == "preflight":
                for action in PROTECTED_ACTIONS:
                    invoke_protected(context, action, "dry-run", action_root)
            else:
                protected = invoke_protected(
                    context, args.action, "execute", action_root
                )
                failed_hash = protected.get("failedV2RootArchiveSha256")
    if args.mode == "execute" and args.action != "pause-v2-writes":
        ensure_sha256(failed_hash, "failed V2 root archive SHA-256")
    else:
        require(failed_hash is None, "unexpected failed V2 root archive identity")
    value = result_value(context, args, failed_hash)
    require(set(value) == RESULT_KEYS, "internal result schema mismatch")
    write_new(result_path, value, 0o400)


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(description=__doc__)
    value.add_argument("--plan", required=True)
    value.add_argument("--plan-sha256", required=True)
    value.add_argument("--component", required=True)
    value.add_argument("--mode", required=True)
    value.add_argument("--action", required=True)
    value.add_argument("--result", required=True)
    return value


def main(argv: Sequence[str] | None = None) -> int:
    try:
        run(parser().parse_args(argv))
    except (DriverError, OSError, subprocess.SubprocessError) as exc:
        print(f"nexus-v2-pre-reset-chain-media: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
