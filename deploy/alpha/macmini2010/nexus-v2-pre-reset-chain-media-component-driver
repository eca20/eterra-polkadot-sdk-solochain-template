class DriverError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise DriverError(message)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def ensure_sha256(value: Any, label: str) -> str:
    require(
        isinstance(value, str) and SHA256_RE.fullmatch(value) is not None,
        f"invalid {label}",
    )
    return value


def read_json(path: Path, label: str) -> dict[str, Any]:
    require(path.is_file() and not path.is_symlink(), f"{label} is unavailable")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise DriverError(f"invalid {label}") from exc
    require(isinstance(value, dict), f"{label} must be an object")
    return value


def immutable_root(source_id: str) -> Path:
    raw = os.environ.get(
        f"NEXUS_V2_PRE_RESET_IMMUTABLE_{source_id.upper()}_ROOT", ""
    )
    require(raw, f"immutable {source_id} root is unavailable")
    path = Path(raw)
    require(path.is_absolute() and path.is_dir() and not path.is_symlink(), f"invalid immutable {source_id} root")
    return path.resolve()


def resolve_pin(pin: Any, roots: Mapping[str, Path], label: str) -> Path:
    require(
        isinstance(pin, dict) and set(pin) == {"sourceId", "path", "sha256"},
        f"{label} pin schema mismatch",
    )
    source_id = pin.get("sourceId")
    require(source_id in roots, f"{label} source is not immutable")
    relative = pin.get("path")
    require(
        isinstance(relative, str)
        and relative
        and not relative.startswith("/")
        and ".." not in Path(relative).parts,
        f"invalid {label} path",
    )
    path = (roots[source_id] / relative).resolve()
    require(roots[source_id] in path.parents, f"{label} escapes its immutable source")
    require(path.is_file() and not path.is_symlink(), f"{label} is unavailable")
    require(
        sha256_file(path) == ensure_sha256(pin.get("sha256"), f"{label} SHA-256"),
        f"{label} hash drifted",
    )
    return path


def validate_plan(args: argparse.Namespace) -> dict[str, Any]:
    plan_path = Path(args.plan).resolve()
    expected = ensure_sha256(args.plan_sha256, "plan SHA-256")
    require(sha256_file(plan_path) == expected, "plan hash mismatch")
    plan = read_json(plan_path, "supervisor plan")
    require(
        plan.get("schemaVersion") == 1
        and plan.get("kind")
        == "nexus-v2-private-alpha-pre-reset-rollback-supervisor-plan",
        "supervisor plan kind mismatch",
    )
    operation_id = plan.get("operationId")
    release_id = plan.get("releaseId")
    site_release = plan.get("siteReleaseVersion")
    source_commit = plan.get("sourceCommit")
    require(isinstance(operation_id, str) and ID_RE.fullmatch(operation_id), "invalid operation ID")
    require(isinstance(release_id, str) and ID_RE.fullmatch(release_id), "invalid chain release ID")
    require(isinstance(site_release, str) and SITE_RELEASE_RE.fullmatch(site_release), "invalid site release version")
    require(isinstance(source_commit, str) and COMMIT_RE.fullmatch(source_commit), "invalid source commit")
    require(
        os.environ.get("NEXUS_V2_PRE_RESET_CHAIN_RELEASE_ID") == release_id
        and os.environ.get("NEXUS_V2_PRE_RESET_SITE_RELEASE_VERSION")
        == site_release
        and os.environ.get("NEXUS_V2_PRE_RESET_SOURCE_COMMIT") == source_commit
        and os.environ.get("NEXUS_V2_PRE_RESET_PLAN_SHA256") == expected,
        "supervisor environment identity mismatch",
    )
    sources = plan.get("sources")
    require(isinstance(sources, dict) and set(sources) == {"chain", "media", "site"}, "source set mismatch")
    roots = {name: immutable_root(name) for name in sources}
    commits: dict[str, str] = {}
    for name, pin in sources.items():
        require(isinstance(pin, dict) and set(pin) == {"root", "expectedCommit"}, f"{name} source schema mismatch")
        commit = pin.get("expectedCommit")
        require(isinstance(commit, str) and COMMIT_RE.fullmatch(commit), f"invalid {name} source commit")
        commits[name] = commit

    components = plan.get("components")
    require(isinstance(components, dict) and set(components) == {"chain-media", "site-indexer"}, "component set mismatch")
    component = components[COMPONENT_ID]
    require(
        isinstance(component, dict)
        and set(component)
        == {"driver", "helperPins", "scriptPins", "requiredResetArchives"},
        "chain-media component schema mismatch",
    )
    driver = resolve_pin(component["driver"], roots, "chain-media driver")
    require(sha256_file(Path(__file__).resolve()) == sha256_file(driver), "executing driver differs from its immutable pin")
    helpers = component.get("helperPins")
    scripts = component.get("scriptPins")
    require(isinstance(helpers, dict) and set(helpers) == {"hostAction"}, "helper role mismatch")
    require(isinstance(scripts, dict) and set(scripts) == SCRIPT_ROLES, "script role mismatch")
    resolved_helpers = {
        role: resolve_pin(pin, roots, f"chain-media helper {role}")
        for role, pin in helpers.items()
    }
    resolved_scripts = {
        role: resolve_pin(pin, roots, f"chain-media script {role}")
        for role, pin in scripts.items()
    }
    archives = component.get("requiredResetArchives")
    require(isinstance(archives, dict) and set(archives) == ARCHIVE_ROLES, "reset archive role mismatch")
    artifacts = plan.get("artifacts")
    require(isinstance(artifacts, dict), "artifact pins are unavailable")
    resolved_artifacts: dict[str, dict[str, Any]] = {}
    for artifact_id, pin in artifacts.items():
        require(isinstance(pin, dict) and set(pin) == {"path", "sha256"}, f"{artifact_id} artifact schema mismatch")
        path = Path(str(pin.get("path"))).resolve()
        require(path.is_file() and not path.is_symlink(), f"{artifact_id} artifact is unavailable")
        artifact_hash = ensure_sha256(pin.get("sha256"), f"{artifact_id} artifact SHA-256")
        require(sha256_file(path) == artifact_hash, f"{artifact_id} artifact drifted")
        resolved_artifacts[artifact_id] = {"path": path, "sha256": artifact_hash}
    required_artifacts = {
        "backupManifest",
        "restoreEvidence",
        "resetReadiness",
        "finalFreezeEvidence",
        "migrationEvidence",
    }
    require(required_artifacts <= set(resolved_artifacts), "recovery artifact set is incomplete")
    readiness_hash = resolved_artifacts["resetReadiness"]["sha256"]
    for role, path_value in archives.items():
        require(
            isinstance(path_value, str)
            and path_value
            == f"/opt/eterra-alpha/archive/nexus-v2-fresh-reset/{readiness_hash}/{role}",
            f"{role} reset archive is not readiness-bound",
        )
    bundle_root = Path(str(plan.get("bundleRoot"))).resolve()
    require(bundle_root.is_dir() and not bundle_root.is_symlink(), "backup bundle root is unavailable")
    return {
        "path": plan_path,
        "sha256": expected,
        "raw": plan,
        "operationId": operation_id,
        "releaseId": release_id,
        "siteReleaseVersion": site_release,
        "sourceCommit": source_commit,
        "backend": plan.get("backend"),
        "fixtureOnly": plan.get("backend") == FIXTURE_BACKEND,
        "fixtureRoot": plan.get("fixtureRoot"),
        "commits": commits,
        "component": component,
        "archives": dict(archives),
        "helpers": resolved_helpers,
        "scripts": resolved_scripts,
        "artifacts": resolved_artifacts,
        "bundleRoot": bundle_root,
    }


def load_staging_library(path: Path) -> Any:
    loader = importlib.machinery.SourceFileLoader("nexus_v2_rollback_staging", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    require(spec is not None, "cannot load rollback staging library")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def validated_staging_hashes(context: Mapping[str, Any]) -> dict[str, str]:
    """Re-hash every byte that could be restored on the protected host.

    The supervisor pins and fully validates the final-backup manifest before
    arming.  Recovery may happen later, so the adapter repeats the file-level
    checks for the exact chain/media restore subset immediately before making
    a staging directory.  A stable manifest alone is insufficient if a large
    archive beneath the bundle root drifted after the arm was published.
    """

    manifest = read_json(
        context["artifacts"]["backupManifest"]["path"], "final backup manifest"
    )
    require(
        manifest.get("schemaVersion") == 1
        and manifest.get("kind") == "nexus-v2-private-alpha-backup"
        and manifest.get("releaseId") == context["releaseId"]
        and manifest.get("sourceCommit") == context["sourceCommit"],
        "final backup manifest identity mismatch",
    )
    entries = manifest.get("artifacts")
    require(isinstance(entries, list), "final backup artifact list is unavailable")
    mapped: dict[tuple[str, str], Mapping[str, Any]] = {}
    for entry in entries:
        require(
            isinstance(entry, dict)
            and set(entry) == {"group", "name", "path", "bytes", "sha256"},
            "final backup artifact schema mismatch",
        )
        key = (entry.get("group"), entry.get("name"))
        require(
            all(isinstance(item, str) and item for item in key)
            and key not in mapped,
            "final backup artifact identity is invalid or duplicated",
        )
        mapped[key] = entry
    require(
        set(STAGING_NAMES) <= set(mapped),
        "final backup lacks the complete chain/media restore subset",
    )
    bundle_root = context["bundleRoot"].resolve()
    staged: dict[str, str] = {}
    for key, output_name in STAGING_NAMES.items():
        entry = mapped[key]
        relative = entry.get("path")
        require(
            isinstance(relative, str)
            and relative
            and not relative.startswith("/")
            and ".." not in Path(relative).parts,
            f"invalid final backup path: {key}",
        )
        source = (bundle_root / relative).resolve()
        require(
            bundle_root in source.parents
            and source.is_file()
            and not source.is_symlink(),
            f"final backup artifact is unavailable: {key}",
        )
        byte_count = entry.get("bytes")
        require(
            isinstance(byte_count, int)
            and not isinstance(byte_count, bool)
            and byte_count >= 0
            and source.stat().st_size == byte_count,
            f"final backup byte count drifted: {key}",
        )
        expected = ensure_sha256(entry.get("sha256"), f"final backup {key} SHA-256")
        require(sha256_file(source) == expected, f"final backup artifact drifted: {key}")
        staged[output_name] = expected
    return staged


def write_new(path: Path, value: Mapping[str, Any], mode: int = 0o600) -> None:
    require(not os.path.lexists(path), f"refusing to overwrite {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    # Supervisor inputs and results share one byte-level canonical JSON
    # contract.  Keep the protected helper context canonical as well so the
    # adapter never has to preserve or trust helper-specific serialization.
    payload = (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(path, mode)


