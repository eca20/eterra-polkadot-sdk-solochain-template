DEPLOY_HOST=192.168.1.159
DEPLOY_USER=eterra2010
# Protected Nexus V2 release transport rejects DEPLOY_PASSWORD and all SSH
# password authentication. This must be an absolute owner-only mode-0400/0600
# file reference; the secret is streamed directly to sudo and is never uploaded.
REMOTE_SUDO_PASSWORD=@/secure/alpha-deploy-sudo-password
SSH_IDENTITY_FILE=~/.ssh/eterra-alpha
# Optional override; defaults to "${SSH_IDENTITY_FILE}.pub"
# SSH_PUBLIC_KEY_FILE=~/.ssh/eterra-alpha.pub
DEPLOY_ROOT=/opt/eterra-alpha
LEGACY_DEPLOY_ROOT=/opt/eterra
MINI_LAN_IP=192.168.1.159
SITE_PROXY_LAN_IP=192.168.1.218
LAN_CIDR=192.168.1.0/24
SITE_PUBLIC_ORIGIN=https://eterra.online
ALPHA_RPC_CORS=https://eterra.online
# Release provenance. Keep dev only for local/non-release deploys. A non-dev
# release requires every expected commit to match a clean source worktree.
ETERRA_RELEASE_VERSION=dev
ETERRA_EXPECTED_CHAIN_COMMIT=
# Runtime/native candidate provenance may intentionally precede the deployment
# helper commit. Nexus V2 uses the already-built spec-106 runtime bundle commit.
ETERRA_EXPECTED_RUNTIME_SOURCE_COMMIT=
ETERRA_EXPECTED_MEDIA_COMMIT=
ETERRA_EXPECTED_SDKGEN_COMMIT=
ALLOW_DIRTY_DEPLOY=0
# Explicitly permits a clean, exact-commit private-alpha release without
# release branches, tags, remote lookups, or pushes.
NEXUS_V2_LOCAL_ONLY_RELEASE=0
# Required only for the guarded pre-V16 fresh-genesis replacement.
NEXUS_V2_RESET_READINESS_SHA256=
# Required for immutable release node promotion. These pin the locally built
# node-candidate.json and its private-alpha genesis identity.
NEXUS_V2_NODE_CANDIDATE_SHA256=
NEXUS_V2_TARGET_IDENTITY_SHA256=
NEXUS_V2_ALPHA_GENESIS_HASH=
# Required together for the immutable pre-published Nexus V2 authority. The
# path names authority-candidate.json inside its relocatable candidate root.
NEXUS_V2_AUTHORITY_CANDIDATE_PATH=
NEXUS_V2_AUTHORITY_CANDIDATE_SHA256=
RUNTIME_SPEC_VERSION=106
RUNTIME_CODE_HASH=unverified
# Required for release evidence; use a stable representative CID URL.
MEDIA_RELEASE_CONTENT_SMOKE_URL=
CHAIN_RPC_PORT=9944
CHAIN_P2P_PORT=30333
MEDIA_PORT=4000
AUTHORITY_PORT=8787
AUTHORITY_BIND_HOST=0.0.0.0
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
ALPHA_OVERRIDES_FILE=/Users/edmundanderson/eterra_projects/polkadot-sdk-solochain-template/chain-specs/alpha-overrides.json
AURA_SURI=@/secure/alpha-validator-aura.suri
GRAN_SURI=@/secure/alpha-validator-grandpa.suri
MEDIA_SIGNER_SEED=@/secure/alpha-media-signer.suri
MEDIA_ADMIN_API_KEY=@/secure/alpha-media-admin-api-key
# The Legends V2 API signs bounded Legends result facts while the runtime owns
# settlement. Keep the legacy Nova Rail submitter strictly in-memory.
AUTHORITY_SUBMITTER_MODE=in_memory
AUTHORITY_RPC_URL=ws://127.0.0.1:9944
AUTHORITY_RELAY_ACCOUNT=replace-with-nova-rail-relay-ss58-account
AUTHORITY_RELAY_MNEMONIC=@/secure/nova-rail-relay.mnemonic
# Optional, only if the relay account was derived with a BIP39 password.
# AUTHORITY_RELAY_DERIVATION_PASSWORD=@/secure/nova-rail-relay.derivation-password
AUTHORITY_FINALITY_TIMEOUT_SECONDS=90
# Nexus V2 live-alpha signer/read-model activation. Every credential uses an
# owner-only absolute @file source; none is copied into candidate artifacts.
ETERRA_LEGENDS_SIGNER_MNEMONIC=@/secure/nexus-v2-authority.mnemonic
# Optional, only for a password-derived signer.
# ETERRA_LEGENDS_SIGNER_DERIVATION_PASSWORD=@/secure/nexus-v2-authority.derivation-password
ETERRA_LEGENDS_PRIVATE_ALPHA_ACCESS_KEY=@/secure/private-alpha-read-model-access-key
ETERRA_LEGENDS_READ_MODEL_URL=https://eterra.online/nexus-api
ETERRA_LEGENDS_READ_MODEL_ADAPTER_VERSION=nexus-v2-game-results-runtime-106-storage-fixture-v2
ETERRA_LEGENDS_AUTHORITY_EPOCH=1
ETERRA_LEGENDS_READ_MODEL_TIMEOUT_SECONDS=10
ETERRA_LEGENDS_OWNER_AUTHORIZATION_TTL_SECONDS=30
# One-shot operator only. This is not installed into the long-running authority service.
ETERRA_ALPHA_SUDO_MNEMONIC=@/secure/alpha-sudo.mnemonic
# Optional, only if the sudo account was derived with a BIP39 password.
# ETERRA_ALPHA_SUDO_DERIVATION_PASSWORD=@/secure/alpha-sudo.derivation-password
NOVA_RAIL_RELAY_AUTHORITY_ID=1
KUBO_IMAGE=ipfs/kubo:v0.33.1
# Release deploys require the same image pinned as ipfs/kubo@sha256:...

# Optional overrides
# SSH_PORT=22
# Protected Nexus V2 releases reject SSH_OPTS and use release-locked host pins.
# REMOTE_NODE_DATA_DIR=/var/lib/eterra-alpha-node
# REMOTE_NODE_SERVICE_NAME=eterra-alpha-node
# NODE_BUILD_MODE=remote-native
# REMOTE_RUST_TOOLCHAIN=stable
# REMOTE_CARGO_JOBS=2
# REMOTE_CARGO_TARGET_DIR=/opt/eterra-alpha/cache/cargo-target
# REMOTE_CARGO_INCREMENTAL=1
# REMOTE_CARGO_CLEAN_AFTER_DEPLOY=1
# ENABLE_REMOTE_SCCACHE=1
# REMOTE_SCCACHE_DIR=/opt/eterra-alpha/cache/sccache
# MEDIA_REPO_DIR=/Users/edmundanderson/eterra_projects/eterra-ipfs-media-service
# AUTHORITY_REPO_DIR=/Users/edmundanderson/eterra_projects/SDKGen/Eterra
# AUTHORITY_SERVICE_NAME=eterra-arcade-authority
# AUTHORITY_RUNTIME_IDENTIFIER=linux-x64
# AUTHORITY_PUBLISH_SELF_CONTAINED=true
# MAX_UPLOAD_BYTES=10485760
# PUBLIC_MEDIA_UPLOAD_ENABLED=false
# CHAIN_REQUEST_TIMEOUT_MS=60000
# IPFS_REQUEST_TIMEOUT_MS=8000
# RENDER_TIMEOUT_MS=15000
# RENDER_CONCURRENCY=4
# PUBLIC_RATE_LIMIT_MAX=120
# PUBLIC_RATE_LIMIT_WINDOW_MS=60000
# ADMIN_RATE_LIMIT_MAX=30
# ADMIN_RATE_LIMIT_WINDOW_MS=60000
