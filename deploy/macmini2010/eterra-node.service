[Unit]
Description=Eterra dev solochain node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eterra2010
Group=eterra2010
EnvironmentFile=-/opt/eterra/shared/env/node.env
WorkingDirectory=/opt/eterra/node/current
ExecStart=/opt/eterra/node/current/start-dev-node.sh
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
